<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- P1-005 fix: مشروع اختبارات Stage1 — يغطي مسارات الأمان المصلحة
         (تجزئة كلمات المرور، فاصل GO، بوابة الصلاحيات) دون الحاجة لقاعدة
         بيانات أو واجهات: كل الأنواع المختبرة مكتبات صرفة. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- V-009 fix (مسحة التحقق): مرجع المشروع الرئيسي جعل الاختبارات لا تُبنى في CI
         إطلاقاً (مشروع SmartAuditERP يحتاج مكتبات P1-001 الخارجية غير المتوفرة في
         المستودع — 59/59 تشغيل CI فشلت تاريخياً). تُضم ملفات المصدر الفعلية للفئات
         الأمنية (مكتبات صرفة بلا تبعيات خارجية) بدل نسخ أو مرجع لا يُبنى —
         الاختبارات تغطي الكود الإنتاجي نفسه حرفياً. -->
    <Compile Include="..\..\SmartAuditERP\Class\Security\PasswordHasher.cs" Link="Security\PasswordHasher.cs" />
    <Compile Include="..\..\SmartAuditERP\Class\Security\SqlBatchSplitter.cs" Link="Security\SqlBatchSplitter.cs" />
    <Compile Include="..\..\SmartAuditERP\Class\Security\PermissionGate.cs" Link="Security\PermissionGate.cs" />
    <!-- مسحة التحقق: مرجع أداة التحديث لاختبار ManifestSignatureVerifier (تحصين P1-020)
         (المشروع مستقل بلا تبعيات خارجية — يُبنى في CI بنجاح) -->
    <ProjectReference Include="..\..\SmartAuditUpdater\SmartAuditUpdater.csproj" />
  </ItemGroup>

</Project>
