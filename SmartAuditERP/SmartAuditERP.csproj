<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- P1-002 fix: المشروع يستخدم عناصر WinForms فعلياً (NotifyIcon/Timer في
         Home.xaml.cs وMainWindow.xaml.cs وfrm_ReportDesign وغيرها) — الإعلان
         الصريح يوثق الاعتماد ويضمن توفر الأنواع بدل الاعتماد الضمني. -->
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU;x86</Platforms>
    <!-- P1-001 fix: مسار مكتبات الأطراف الخارجية قابل للتهيئة (افتراضي كما كان)؛
         ضع ExternalLibsDir=... عند البناء أو عبر مجلد libs/ لاحقاً. -->
    <ExternalLibsDir Condition="'$(ExternalLibsDir)' == ''">..\..\المكاتب</ExternalLibsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="DevExpress.Data" Version="25.2.3" />
    <PackageReference Include="DevExpress.Images" Version="25.2.3" />
    <PackageReference Include="DevExpress.Reporting.Core" Version="25.2.3" />
    <PackageReference Include="DevExpress.Win.Design" Version="25.2.3" />
    <PackageReference Include="DevExpress.Wpf.Core" Version="25.2.3" />
    <PackageReference Include="DevExpress.Wpf.ExpressionEditor" Version="25.2.3" />
    <PackageReference Include="DevExpress.Wpf.Grid.Core" Version="25.2.3" />
    <PackageReference Include="DevExpress.Wpf.ThemesLW" Version="25.2.3" />
    <PackageReference Include="Nancy" Version="2.0.0" />
    <PackageReference Include="System.Management" Version="10.0.7" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- P1-001 fix: كان مرجعاً مطلقاً لمسار مستخدم محلي — الآن حزمة معلنة -->
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartAuditUpdater\SmartAuditUpdater.csproj" />
  </ItemGroup>

  <!-- P1-004 fix: ملفات التشغيل المطلوبة وقت التنفيذ تُرفق بالمخرجات —
       كانت تُطلب (File.Exists) دون أن ترافق النشر فيفشل السجل/الإصدار بصمت. -->
  <ItemGroup>
    <None Update="Version.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="log4net.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="AuditorAPI">
      <HintPath>$(ExternalLibsDir)\AuditorAPI.exe</HintPath>
    </Reference>
    <Reference Include="BouncyCastle.Crypto">
      <HintPath>$(ExternalLibsDir)\BouncyCastle.Crypto.dll</HintPath>
    </Reference>
    <Reference Include="drHamiedNotify">
      <HintPath>$(ExternalLibsDir)\drHamiedNotify.dll</HintPath>
    </Reference>
    <Reference Include="EASendMail">
      <HintPath>$(ExternalLibsDir)\EASendMail.dll</HintPath>
    </Reference>
    <Reference Include="ECRPaymentsAPI">
      <HintPath>$(ExternalLibsDir)\ECRPaymentsAPI.dll</HintPath>
    </Reference>
    <Reference Include="ETA_Invoice">
      <HintPath>$(ExternalLibsDir)\ETA_Invoice.dll</HintPath>
    </Reference>
    <Reference Include="ExcelDataReader">
      <HintPath>$(ExternalLibsDir)\ExcelDataReader.dll</HintPath>
    </Reference>
    <Reference Include="ExcelDataReader.DataSet">
      <HintPath>$(ExternalLibsDir)\ExcelDataReader.DataSet.dll</HintPath>
    </Reference>
    <Reference Include="FastMember">
      <HintPath>$(ExternalLibsDir)\FastMember.dll</HintPath>
    </Reference>
    <Reference Include="FontAwesome.Sharp">
      <HintPath>$(ExternalLibsDir)\FontAwesome.Sharp.dll</HintPath>
    </Reference>
    <Reference Include="GenCode128">
      <HintPath>$(ExternalLibsDir)\GenCode128.dll</HintPath>
    </Reference>
    <Reference Include="ICSharpCode.SharpZipLib">
      <HintPath>$(ExternalLibsDir)\ICSharpCode.SharpZipLib.dll</HintPath>
    </Reference>
    <Reference Include="itextsharp">
      <HintPath>$(ExternalLibsDir)\itextsharp.dll</HintPath>
    </Reference>
    <Reference Include="JWT">
      <HintPath>$(ExternalLibsDir)\JWT.dll</HintPath>
    </Reference>
    <Reference Include="log4net">
      <HintPath>$(ExternalLibsDir)\log4net.dll</HintPath>
    </Reference>
    <Reference Include="M2Mqtt.Net">
      <HintPath>$(ExternalLibsDir)\M2Mqtt.Net.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.AspNet.SignalR.Client">
      <HintPath>$(ExternalLibsDir)\Microsoft.AspNet.SignalR.Client.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.SqlServer.ConnectionInfo">
      <HintPath>$(ExternalLibsDir)\Microsoft.SqlServer.ConnectionInfo.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.SqlServer.ConnectionInfoExtended">
      <HintPath>$(ExternalLibsDir)\Microsoft.SqlServer.ConnectionInfoExtended.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualBasic.PowerPacks.Vs">
      <HintPath>$(ExternalLibsDir)\Microsoft.VisualBasic.PowerPacks.Vs.dll</HintPath>
    </Reference>
    <Reference Include="neoleapconnector">
      <HintPath>$(ExternalLibsDir)\neoleapconnector.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ExternalLibsDir)\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="PdfSharp">
      <HintPath>$(ExternalLibsDir)\PdfSharp.dll</HintPath>
    </Reference>
    <Reference Include="PdfSharp.Charting">
      <HintPath>$(ExternalLibsDir)\PdfSharp.Charting.dll</HintPath>
    </Reference>
    <Reference Include="Pkcs11Interop">
      <HintPath>$(ExternalLibsDir)\Pkcs11Interop.dll</HintPath>
    </Reference>
    <Reference Include="QLicense">
      <HintPath>$(ExternalLibsDir)\QLicense.dll</HintPath>
    </Reference>
    <Reference Include="QRCoder">
      <HintPath>$(ExternalLibsDir)\QRCoder.dll</HintPath>
    </Reference>
    <Reference Include="RestSharp">
      <HintPath>$(ExternalLibsDir)\RestSharp.dll</HintPath>
    </Reference>
    <Reference Include="saxon-he-10.8">
      <HintPath>$(ExternalLibsDir)\saxon-he-10.8.dll</HintPath>
    </Reference>
    <Reference Include="saxon-he-api-10.8">
      <HintPath>$(ExternalLibsDir)\saxon-he-api-10.8.dll</HintPath>
    </Reference>
    <Reference Include="System.Net.Http.Extensions">
      <HintPath>$(ExternalLibsDir)\System.Net.Http.Extensions.dll</HintPath>
    </Reference>
    <Reference Include="System.Net.Http.Formatting">
      <HintPath>$(ExternalLibsDir)\System.Net.Http.Formatting.dll</HintPath>
    </Reference>
    <Reference Include="System.Net.Http.Primitives">
      <HintPath>$(ExternalLibsDir)\System.Net.Http.Primitives.dll</HintPath>
    </Reference>
    <Reference Include="Twilio">
      <HintPath>$(ExternalLibsDir)\Twilio.dll</HintPath>
    </Reference>
    <Reference Include="UtilitiesProj">
      <HintPath>$(ExternalLibsDir)\UtilitiesProj.dll</HintPath>
    </Reference>
    <Reference Include="WebDriver">
      <HintPath>$(ExternalLibsDir)\WebDriver.dll</HintPath>
    </Reference>
    <Reference Include="WebDriver.Support">
      <HintPath>$(ExternalLibsDir)\WebDriver.Support.dll</HintPath>
    </Reference>
    <Reference Include="websocket-sharp">
      <HintPath>$(ExternalLibsDir)\websocket-sharp.dll</HintPath>
    </Reference>
    <Reference Include="WhatsAppApi">
      <HintPath>$(ExternalLibsDir)\WhatsAppApi.dll</HintPath>
    </Reference>
    <Reference Include="Ws_Auditor">
      <HintPath>$(ExternalLibsDir)\Ws_Auditor.dll</HintPath>
    </Reference>
    <Reference Include="ZatcaIntegrationSDK">
      <HintPath>$(ExternalLibsDir)\ZatcaIntegrationSDK.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
