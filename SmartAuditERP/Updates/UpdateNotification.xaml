<dx:ThemedWindow
    x:Class="SmartAuditERP.Form_WPF.UpdateNotification"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    Title="🔄 تحديث جديد متوفر"
    Width="520" Height="420"
    WindowStartupLocation="CenterScreen"
    FlowDirection="RightToLeft"
    Background="#F3F5F9"
    FontFamily="Cairo, Tahoma, Arial"
    ResizeMode="NoResize">

    <dx:ThemedWindow.Resources>
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#213A7A" Offset="0"/>
            <GradientStop Color="#3A63C3" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SaveBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2CC36B" Offset="0"/>
            <GradientStop Color="#1B8E4A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E35656" Offset="0"/>
            <GradientStop Color="#B92F2F" Offset="1"/>
        </LinearGradientBrush>
    </dx:ThemedWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- العنوان -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderBrush}"
                Padding="16,12">
            <StackPanel>
                <TextBlock Text="🔄 تحديث جديد متوفر!"
                           Foreground="White"
                           FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="txtVersionInfo"
                           Foreground="#B0C4FF"
                           FontSize="13" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- التفاصيل -->
        <ScrollViewer Grid.Row="1" Margin="16,10"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- عنوان الإصدار -->
                <Border Background="White" CornerRadius="8"
                        Padding="12,8" Margin="0,0,0,8"
                        BorderBrush="#D0D7E8" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📋 عنوان الإصدار"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#6B7280"/>
                        <TextBlock x:Name="txtReleaseTitle"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#1B2642"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ملاحظات الإصدار -->
                <Border Background="White" CornerRadius="8"
                        Padding="12,8" Margin="0,0,0,8"
                        BorderBrush="#D0D7E8" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📝 ملاحظات الإصدار"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="#6B7280"/>
                        <TextBlock x:Name="txtReleaseNotes"
                                   FontSize="12"
                                   Foreground="#374151"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- معلومات إضافية -->
                <Border Background="White" CornerRadius="8"
                        Padding="12,8"
                        BorderBrush="#D0D7E8" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   FontSize="11" Foreground="#6B7280">
                            <Run Text="📅 تاريخ الإصدار: "/>
                            <Run x:Name="txtReleaseDate"
                                 FontWeight="Bold" Foreground="#1B2642"/>
                        </TextBlock>

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   FontSize="11" Foreground="#6B7280">
                            <Run Text="📦 حجم الملف: "/>
                            <Run x:Name="txtFileSize"
                                 FontWeight="Bold" Foreground="#1B2642"/>
                        </TextBlock>

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   FontSize="11" Foreground="#6B7280"
                                   Margin="0,4,0,0">
                            <Run Text="📄 اسم الملف: "/>
                            <Run x:Name="txtFileName"
                                 FontWeight="Bold" Foreground="#1B2642"/>
                        </TextBlock>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- الأزرار -->
        <Border Grid.Row="2"
                Background="#E8ECF5"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1"
                        Content="❌ لاحقاً"
                        Width="100" Height="36"
                        FontSize="13" FontWeight="Bold"
                        Foreground="White"
                        Click="BtnLater_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{StaticResource DangerBrush}"
                                    CornerRadius="8" Padding="8,0"
                                    Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="3"
                        Content="✅ تحديث الآن"
                        Width="120" Height="36"
                        FontSize="13" FontWeight="Bold"
                        Foreground="White"
                        Click="BtnUpdate_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{StaticResource SaveBrush}"
                                    CornerRadius="8" Padding="8,0"
                                    Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</dx:ThemedWindow>